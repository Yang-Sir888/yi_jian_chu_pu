# 国韵谱音 · 服务端配置模板
# 使用方式：复制本文件为同目录下的 .env，按需修改后重启服务。
# 已存在的系统环境变量优先级更高（不会被本文件覆盖）。

# ---- 站点地址（最重要） ----
# 必须与浏览器地址栏里的地址完全一致，含 http/https 与端口。
# 不一致时登录会提示「请从正式网站操作，当前地址与服务配置不一致」。
APP_ORIGIN=http://localhost:3000

# 服务监听端口与地址（0.0.0.0 允许局域网访问）
PORT=3000
HOST=0.0.0.0

# ---- 数据库 ----
# 本地 / 自建 PostgreSQL 连接串
# 留空时自动使用 PGlite，无需安装数据库；生产多副本请填写外部 PostgreSQL。
DATABASE_URL=
# 持久数据目录（PGlite 和密钥保险箱），Docker 示例为 /data。
# 留空时本地数据库默认 backend/.data，密钥文件默认 backend/.model-vault.key。
DATA_DIR=
# 0 = 使用上面的 PostgreSQL（本地或自建部署请保持 0）
TCB_PG_PROXY=0
# 连接池上限
PG_POOL_MAX=6

# ---- 安全 ----
# 仅在反向代理（Nginx / Caddy 等）后面才设为 1
TRUST_PROXY=false
# 更换域名或同时用多个域名时，用逗号分隔填写，例如：
# APP_EXTRA_ORIGINS=https://score.example.com,https://www.example.com
APP_EXTRA_ORIGINS=
# 模型并发上限
MAX_MODEL_CONCURRENCY=2
# 全站每日付费请求次数上限，按 UTC 日期重置；失败请求也计数（供应商可能计费）。
# 此项限制次数，不等同于阿里云账单金额；另请在百炼设置费用预警。
MAX_MODEL_CALLS_PER_DAY=300

# ---- 存储 ----
# 音频总容量上限（MB），超出后拒绝新的上传
MAX_STORAGE_MB=4096

# ---- 百炼智能整理（可选） ----
# 也可以留空，部署后在「账号与模型管理」网页里填写（推荐，密钥不落在本文件里）。
# Base URL 需为百炼控制台的 OpenAI 兼容地址，末尾 /compatible-mode/v1
JIANPU_LLM_BASE=
# 留空时页面配置可持久保存；未配置时默认模型 qwen-plus。
# 显式填写环境变量会在重启时覆盖页面保存的模型名。
JIANPU_LLM_MODEL=
JIANPU_LLM_KEY=
# 密钥保险箱主密钥（32 字节 base64）。留空则自动生成并保存到 backend/.model-vault.key
MODEL_VAULT_KEY=

# ---- 独立托管首次引导（可选） ----
# 仅首次创建账号时读取；已有账号不会因环境值变化而重置。
# 如需设置，通过托管平台的 Secret 配置 ADMIN_PASSWORD / EXPERT_PASSWORD，
# 各为12–128字符，不要将真实密码写入此模板或仓库。
# 明确设置 EXPERT_PASSWORD 时，expert01 可直接评审；未设置仍首次强制改密。
# Render 无 APP_ORIGIN 时自动采用其 RENDER_EXTERNAL_URL，其他部署仍显式配置。
